{
  "hosting": {
    "public": "portfolio",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/portfolio-webimages/**",
      "**/assets/img/fashinza/*.png"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
